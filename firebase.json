{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8088
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": "www",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/demande-adhesion.pdf",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"demande-adhesion.pdf\""
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
