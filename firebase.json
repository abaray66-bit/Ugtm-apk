{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8088
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": "www",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/demande-adhesion.pdf",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"demande-adhesion.pdf\""
          }
        ]
      }
    ],
    "rewrites": [
      { "source": "**", "destination": "/app.html" }
    ]
  }
}
