{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "www",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/demande-adhesion.pdf",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"demande-adhesion.pdf\""
          }
        ]
      }
    ]
  }
}
