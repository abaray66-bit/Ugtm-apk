rules_version = '2';

// Règles de sécurité – UGTM Souss-Massa
// À coller dans Firebase > Firestore Database > onglet « Règles », puis « Publier ».
// Administrateur configuré : abaray66@gmail.com

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Administrateur = compte Google dont l'adresse est dans cette liste (et vérifiée par Google).
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['abaray66@gmail.com'];
    }

    // Adhérent validé par l'administrateur.
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'active';
    }

    function okText(v, max) {
      return v is string && v.size() <= max;
    }

    // ---------- Profils des membres ----------
    match /members/{uid} {

      // Un membre ne lit que son profil. L'administrateur lit tout.
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      // À la première connexion : profil "en attente", jamais "actif" ni avec un numéro d'adhérent.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['name', 'email', 'photo', 'etab', 'prov', 'phone', 'status', 'createdAt'])
        && okText(request.resource.data.name, 120)
        && okText(request.resource.data.etab, 160)
        && okText(request.resource.data.prov, 40)
        && okText(request.resource.data.phone, 30);

      // Le membre ne peut modifier que ses informations, pas son statut ni son numéro.
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'etab', 'prov', 'phone', 'updatedAt'])
            && okText(request.resource.data.name, 120)
            && okText(request.resource.data.etab, 160)
            && okText(request.resource.data.prov, 40)
            && okText(request.resource.data.phone, 30));

      // Un membre peut supprimer ses propres données ; l'administrateur aussi.
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // ---------- Communiqués ----------
    match /news/{id} {
      // Publics pour tous ; "members" réservés aux adhérents validés et à l'administrateur.
      allow read: if resource.data.audience == 'public' || isActive() || isAdmin();
      allow write: if isAdmin();
    }

    // ---------- Événements ----------
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
