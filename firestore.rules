rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['abaray66@gmail.com'];
    }

    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'active';
    }

    function okText(v, max) {
      return v is string && v.size() <= max;
    }

    match /members/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'photo', 'etab', 'prov',
          'phone', 'status', 'createdAt'
        ])
        && okText(request.resource.data.name, 120)
        && okText(request.resource.data.etab, 160)
        && okText(request.resource.data.prov, 40)
        && okText(request.resource.data.phone, 30);

      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'etab', 'prov', 'phone', 'updatedAt'])
            && okText(request.resource.data.name, 120)
            && okText(request.resource.data.etab, 160)
            && okText(request.resource.data.prov, 40)
            && okText(request.resource.data.phone, 30));

      allow delete: if isAdmin()
        || (signedIn() && request.auth.uid == uid);
    }

    match /news/{id} {
      allow read: if resource.data.audience == 'public'
        || isActive()
        || isAdmin();

      allow write: if isAdmin();
    }

    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================
    // SIGNALEMENTS
    // =========================

    match /reports/{id} {

      // Un membre peut lire uniquement ses propres signalements.
      // L'administrateur peut tous les lire.
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.anonymous == false
          && resource.data.ownerUid == request.auth.uid
        );

      // Création d'un signalement
      allow create: if signedIn()

        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'anonymous',
          'name',
          'etab',
          'category',
          'description',
          'date',
          'location',
          'attachmentName',
          'attachmentType',
          'attachmentData',
          'status',
          'response',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.status == 'new'
        && request.resource.data.response == ''

        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time

        && request.resource.data.anonymous is bool

        && request.resource.data.name is string
        && request.resource.data.etab is string
        && request.resource.data.category is string
        && request.resource.data.description is string
        && request.resource.data.date is string
        && request.resource.data.location is string

        && request.resource.data.attachmentName is string
        && request.resource.data.attachmentType is string
        && request.resource.data.attachmentData is string

        && okText(request.resource.data.name, 120)
        && okText(request.resource.data.etab, 160)
        && okText(request.resource.data.category, 60)
        && okText(request.resource.data.description, 4000)
        && okText(request.resource.data.date, 20)
        && okText(request.resource.data.location, 160)

        && okText(request.resource.data.attachmentName, 120)
        && okText(request.resource.data.attachmentType, 80)
        && okText(request.resource.data.attachmentData, 420000)

        // Signalement anonyme :
        // aucune identité ni UID n'est enregistré.
        && (
          (
            request.resource.data.anonymous == true
            && request.resource.data.ownerUid == ''
            && request.resource.data.name == ''
          )

          ||

          // Signalement identifié :
          // il est lié au compte de l'utilisateur.
          (
            request.resource.data.anonymous == false
            && request.resource.data.ownerUid == request.auth.uid
          )
        );

      // Seul l'administrateur peut modifier le statut ou répondre.
      allow update: if isAdmin();

      // Seul l'administrateur peut supprimer un signalement.
      allow delete: if isAdmin();
    }
  }
}
