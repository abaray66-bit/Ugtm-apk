rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // LISTE DES ADMINISTRATEURS — externalisée dans config/admins.
    // Deux sources, testées à l'identique dans isAdmin() :
    //  1. Cette liste de SECOURS, codée en dur : elle garantit que le
    //     responsable du projet garde toujours la main, même si le
    //     document config/admins manquait ou était corrompu.
    //     Elle ne peut pas être vidée depuis l'application.
    //  2. Le document config/admins, modifiable depuis l'espace
    //     administrateur, sans redéploiement des règles.
    function bootstrapAdminEmails() {
      return ['abaray66@gmail.com'];
    }

    function storedAdminEmails() {
      return exists(/databases/$(database)/documents/config/admins)
        ? get(/databases/$(database)/documents/config/admins).data.emails
        : [];
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.email in bootstrapAdminEmails()
          || request.auth.token.email in storedAdminEmails()
          || request.auth.token.email == 'abaray66@gmail.com'
        );
    }

    function canManageDialogue() {
      return isAdmin() || isSubAdmin() || isSubAdminLocal();
    }

    function isSubAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'subadmin';
    }

    function assignedProvince() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.adminProvince;
    }

    function isSubAdminLocal() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'subadminLocal';
    }

    function assignedLocalStructure() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.adminStructure;
    }

    function assignedProvinceLabel() {
      return assignedProvince() == 'agadir' ? 'Agadir Ida-Outanane' :
             assignedProvince() == 'inezgane' ? 'Inezgane-Aït Melloul' :
             assignedProvince() == 'chtouka' ? 'Chtouka-Aït Baha' :
             assignedProvince() == 'taroudant' ? 'Taroudant' :
             assignedProvince() == 'tiznit' ? 'Tiznit' :
             assignedProvince() == 'tata' ? 'Tata' :
             assignedProvince();
    }

    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'active';
    }

    function okText(v, max) {
      return v is string && v.size() <= max;
    }

    function isReportManager(reportData) {
      return isAdmin()
        || (isSubAdmin() && (reportData.province == assignedProvince()
            || reportData.province == assignedProvinceLabel()))
        || (isSubAdminLocal() && reportData.get('structureId', '') != ''
            && reportData.structureId == assignedLocalStructure());
    }

    // ==========================================================
    // LISTE DES ADMINISTRATEURS — document unique config/admins
    // Lecture réservée aux comptes connectés (elle alimente
    // l'affichage ; les droits réels restent portés par isAdmin()).
    // Écriture réservée aux administrateurs, avec trois garde-fous :
    // la liste de secours doit rester entière (impossible de se
    // verrouiller), 10 adresses maximum, clés exactes.
    // ==========================================================
    match /config/admins {
      allow read: if signedIn();

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['emails', 'updatedAt'])
        && request.resource.data.emails is list
        && request.resource.data.emails.size() >= 1
        && request.resource.data.emails.size() <= 10
        && request.resource.data.emails.hasAll(bootstrapAdminEmails())
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /config/dialogueSocial {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isSubAdmin() || isSubAdminLocal() || (signedIn() && request.auth.token.email == 'abaray66@gmail.com');
    }

    match /dialogueSocialDocs/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if canManageDialogue() || (signedIn() && request.auth.token.email == 'abaray66@gmail.com');
    }
    match /dialogueSocialChunks/{chunkId} {
      allow read: if signedIn();
      allow create, update, delete: if canManageDialogue() || (signedIn() && request.auth.token.email == 'abaray66@gmail.com');
    }

    match /members/{uid} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == uid)
        || (isSubAdmin() && resource.data.prov == assignedProvince())
        || (isSubAdminLocal() && resource.data.adminStructure == assignedLocalStructure());

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'photo', 'etab', 'prov',
          'phone', 'status', 'createdAt'
        ])
        && okText(request.resource.data.name, 120)
        && okText(request.resource.data.etab, 160)
        && okText(request.resource.data.prov, 40)
        && okText(request.resource.data.phone, 30)
        // Validation d'une demande d'adhésion : le
        // responsable crée la fiche adhérent (actif,
        // numéroté depuis le compteur global). Le
        // compteur et la fiche sont écrits dans la
        // même transaction : lastMemberNo correspond
        // obligatoirement au numéro de la fiche.
        || ((isAdmin()
            || (isSubAdmin() && request.resource.data.prov == assignedProvince()
                && request.resource.data.role == 'member'
                && request.resource.data.adminProvince == assignedProvince()))
            && request.resource.data.status == 'active'
            && request.resource.data.keys().hasOnly([
              'name', 'email', 'photo', 'etab', 'prov',
              'phone', 'status', 'memberNo', 'activatedAt', 'createdAt',
              'role', 'adminProvince'
            ])
            && okText(request.resource.data.name, 120)
            && okText(request.resource.data.email, 254)
            && okText(request.resource.data.etab, 160)
            && okText(request.resource.data.prov, 40)
            && okText(request.resource.data.phone, 30)
            && okText(request.resource.data.memberNo, 30)
            && request.resource.data.memberNo.matches('SM-[0-9]{4,}')
            && getAfter(/databases/$(database)/documents/counters/memberNumbers).data
              .lastMemberNo == request.resource.data.memberNo)
        || (isAdmin()
            && request.resource.data.status == 'active'
            && request.resource.data.role == 'subadminLocal'
            && request.resource.data.keys().hasOnly([
              'name', 'email', 'photo', 'etab', 'prov',
              'phone', 'status', 'memberNo', 'activatedAt', 'createdAt',
              'role', 'adminStructure'
            ])
            && okText(request.resource.data.name, 120)
            && okText(request.resource.data.email, 254)
            && okText(request.resource.data.etab, 160)
            && okText(request.resource.data.prov, 40)
            && okText(request.resource.data.phone, 30)
            && okText(request.resource.data.memberNo, 30)
            && request.resource.data.memberNo.matches('SM-[0-9]{4,}')
            && okText(request.resource.data.adminStructure, 40)
            && request.resource.data.adminStructure.size() > 0
            && exists(/databases/$(database)/documents/localStructures/$(request.resource.data.adminStructure))
            && get(/databases/$(database)/documents/localStructures/$(request.resource.data.adminStructure)).data.archived == false
            && get(/databases/$(database)/documents/localStructures/$(request.resource.data.adminStructure)).data.province == request.resource.data.prov
            && getAfter(/databases/$(database)/documents/counters/memberNumbers).data
              .lastMemberNo == request.resource.data.memberNo)
        // Sous-admin local : activation adhésion de SA structure
        // (mêmes champs que subadmin provincial + adminStructure)
        || (isSubAdminLocal()
            && request.resource.data.status == 'active'
            && request.resource.data.role == 'member'
            && request.resource.data.keys().hasOnly([
              'name', 'email', 'photo', 'etab', 'prov',
              'phone', 'status', 'memberNo', 'activatedAt', 'createdAt',
              'role', 'adminProvince', 'adminStructure'
            ])
            && okText(request.resource.data.name, 120)
            && okText(request.resource.data.email, 254)
            && okText(request.resource.data.etab, 160)
            && okText(request.resource.data.prov, 40)
            && okText(request.resource.data.phone, 30)
            && okText(request.resource.data.memberNo, 30)
            && request.resource.data.memberNo.matches('SM-[0-9]{4,}')
            && request.resource.data.adminProvince == request.resource.data.prov
            && request.resource.data.adminStructure == assignedLocalStructure()
            && exists(/databases/$(database)/documents/localStructures/$(request.resource.data.adminStructure))
            && get(/databases/$(database)/documents/localStructures/$(request.resource.data.adminStructure)).data.archived == false
            && get(/databases/$(database)/documents/localStructures/$(request.resource.data.adminStructure)).data.province == request.resource.data.prov
            && getAfter(/databases/$(database)/documents/counters/memberNumbers).data
              .lastMemberNo == request.resource.data.memberNo);

      allow update: if (
          isAdmin()
            && (request.resource.data.get('role', '') != 'subadminLocal'
              || (okText(request.resource.data.adminStructure, 40)
                  && request.resource.data.adminStructure.size() > 0
                  && exists(/databases/$(database)/documents/localStructures/$(request.resource.data.adminStructure))
                  && get(/databases/$(database)/documents/localStructures/$(request.resource.data.adminStructure)).data.archived == false
                  && get(/databases/$(database)/documents/localStructures/$(request.resource.data.adminStructure)).data.province == request.resource.data.prov))
        )
        // Administrateur général : activation sans dossier d'adhésion
        // (migration, cas exceptionnels). Exige numéro depuis le compteur.
        || (isAdmin()
            && resource.data.status != 'active'
            && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'email', 'photo', 'etab', 'prov',
                'phone', 'status', 'memberNo', 'activatedAt', 'updatedAt',
                'role', 'adminProvince', 'adminStructure'])
            && okText(request.resource.data.name, 120)
            && okText(request.resource.data.email, 254)
            && okText(request.resource.data.etab, 160)
            && okText(request.resource.data.prov, 40)
            && okText(request.resource.data.phone, 30)
            && okText(request.resource.data.memberNo, 30)
            && request.resource.data.memberNo.matches('SM-[0-9]{4,}')
            && getAfter(/databases/$(database)/documents/counters/memberNumbers).data
                 .lastMemberNo == request.resource.data.memberNo)
        // Activation d'un adhérent en attente par son
        // sous-admin de province : la fiche complète du
        // dossier signé (coordonnées) peut être enregistrée
        // en même temps que l'activation et le numéro.
        || (isSubAdmin() && resource.data.prov == assignedProvince()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'email', 'photo', 'etab', 'prov',
                'phone', 'status', 'memberNo', 'activatedAt', 'updatedAt'])
            && okText(request.resource.data.name, 120)
            && okText(request.resource.data.email, 254)
            && okText(request.resource.data.etab, 160)
            && okText(request.resource.data.prov, 40)
            && okText(request.resource.data.phone, 30)
            && okText(request.resource.data.memberNo, 30)
            // La numérotation vient OBLIGATOIREMENT du compteur global,
            // écrite dans le même lot : le numéro du membre doit être
            // exactement le dernier numéro émis (cf. activateMemberFromRequest
            // de cloud.js, transaction counters/memberNumbers).
            && request.resource.data.memberNo.matches('SM-[0-9]{4,}')
            && getAfter(/databases/$(database)/documents/counters/memberNumbers).data
                 .lastMemberNo == request.resource.data.memberNo)
        // Validation d'une adhésion par sous-admin provincial / admin général :
        // active le membre en attente avec numéro, rôle, province admin et dates.
        // La transaction inclut aussi l'écriture du compteur (getAfter).
        || (isSubAdmin() && resource.data.prov == assignedProvince()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'email', 'photo', 'etab', 'prov',
                'phone', 'status', 'memberNo', 'activatedAt', 'updatedAt',
                'role', 'adminProvince', 'createdAt'])
            && okText(request.resource.data.name, 120)
            && okText(request.resource.data.email, 254)
            && okText(request.resource.data.etab, 160)
            && okText(request.resource.data.prov, 40)
            && okText(request.resource.data.phone, 30)
            && okText(request.resource.data.memberNo, 30)
            && request.resource.data.memberNo.matches('SM-[0-9]{4,}')
            && request.resource.data.role == 'member'
            && request.resource.data.adminProvince == request.resource.data.prov
            && getAfter(/databases/$(database)/documents/counters/memberNumbers).data
                 .lastMemberNo == request.resource.data.memberNo)
        || (isAdmin() && resource.data.status == 'pending'
            && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'email', 'photo', 'etab', 'prov',
                'phone', 'status', 'memberNo', 'activatedAt', 'updatedAt',
                'role', 'adminProvince', 'createdAt', 'adminStructure'])
            && okText(request.resource.data.name, 120)
            && okText(request.resource.data.email, 254)
            && okText(request.resource.data.etab, 160)
            && okText(request.resource.data.prov, 40)
            && okText(request.resource.data.phone, 30)
            && okText(request.resource.data.memberNo, 30)
            && request.resource.data.memberNo.matches('SM-[0-9]{4,}')
            && request.resource.data.role == 'member'
            && request.resource.data.adminProvince == request.resource.data.prov
            && getAfter(/databases/$(database)/documents/counters/memberNumbers).data
                 .lastMemberNo == request.resource.data.memberNo)
        // Validation d'une adhésion par sous-admin local :
        // active le membre en attente avec numéro, rôle, province admin,
        // structure admin et dates. La transaction inclut l'écriture du compteur.
        || (isSubAdminLocal() && resource.data.adminStructure == assignedLocalStructure()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'email', 'photo', 'etab', 'prov',
                'phone', 'status', 'memberNo', 'activatedAt', 'updatedAt',
                'role', 'adminProvince', 'adminStructure', 'createdAt'])
            && okText(request.resource.data.name, 120)
            && okText(request.resource.data.email, 254)
            && okText(request.resource.data.etab, 160)
            && okText(request.resource.data.prov, 40)
            && okText(request.resource.data.phone, 30)
            && okText(request.resource.data.memberNo, 30)
            && request.resource.data.memberNo.matches('SM-[0-9]{4,}')
            && request.resource.data.role == 'member'
            && request.resource.data.adminProvince == request.resource.data.prov
            && request.resource.data.adminStructure == assignedLocalStructure()
            && exists(/databases/$(database)/documents/localStructures/$(request.resource.data.adminStructure))
            && get(/databases/$(database)/documents/localStructures/$(request.resource.data.adminStructure)).data.archived == false
            && get(/databases/$(database)/documents/localStructures/$(request.resource.data.adminStructure)).data.province == request.resource.data.prov
            && getAfter(/databases/$(database)/documents/counters/memberNumbers).data
                 .lastMemberNo == request.resource.data.memberNo)
        // Rafraîchissement des coordonnées d'un adhérent
        // actif de la province (renouvellement signé).
        || (isSubAdmin() && resource.data.prov == assignedProvince()
            && resource.data.status == 'active'
            && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'email', 'photo', 'etab', 'prov', 'phone', 'updatedAt'])
            && okText(request.resource.data.name, 120)
            && okText(request.resource.data.email, 254)
            && okText(request.resource.data.etab, 160)
            && okText(request.resource.data.prov, 40)
            && okText(request.resource.data.phone, 30))
        // Gestion des membres de sa structure par le sous-admin local.
        || (isSubAdminLocal() && resource.data.adminStructure == assignedLocalStructure()
            && request.resource.data.adminStructure == assignedLocalStructure()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'email', 'photo', 'etab', 'prov',
                'phone', 'status', 'updatedAt'])
            && okText(request.resource.data.name, 120)
            && okText(request.resource.data.email, 254)
            && okText(request.resource.data.etab, 160)
            && okText(request.resource.data.prov, 40)
            && okText(request.resource.data.phone, 30)
            && (request.resource.data.status == 'active'
                || request.resource.data.status == 'blocked'
                || request.resource.data.status == resource.data.status))
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'etab', 'phone', 'updatedAt'])
            && okText(request.resource.data.name, 120)
            && okText(request.resource.data.etab, 160)
            && okText(request.resource.data.prov, 40)
            && okText(request.resource.data.phone, 30));

      // Un administrateur de province (sous-admin) ou local (subadminLocal)
      // ne peut pas supprimer son propre compte : seul l'administrateur
      // principal peut le faire. ('role' absent des profils classiques
      // = non sous-admin, autorisé.)
      allow delete: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && (!('role' in resource.data)
                || (resource.data.role != 'subadmin'
                    && resource.data.role != 'subadminLocal')));
    }

    // ==========================================================
    // COMPTEURS — numérotation atomique des adhérents (SM-0001…)
    // Un numéro n'est émis qu'avec l'activation d'un membre, dans le
    // même lot : l'invariant est vérifié dans les deux sens
    // (membre ⇄ compteur) via getAfter.
    // L'administrateur général peut créer/corriger le compteur librement
    // (migration, réparation) ; un sous-admin n'y touche que pour activer
    // un membre PENDANT de sa propre province.
    // ==========================================================
    match /counters/{counterId} {
      allow read: if isAdmin() || isSubAdmin() || isSubAdminLocal();

      allow create: if isAdmin()
        || (isSubAdmin()
          && counterId == 'memberNumbers'
          && request.resource.data.keys().hasAll(
            ['next', 'lastMemberNo', 'memberUid', 'updatedAt'])
          && request.resource.data.keys().hasOnly(
            ['next', 'lastMemberNo', 'memberUid', 'updatedAt'])
          && request.resource.data.next is int
          && request.resource.data.next >= 2
          && request.resource.data.lastMemberNo is string
          && request.resource.data.lastMemberNo.matches('SM-[0-9]{4,}')
          && request.resource.data.memberUid is string
          && request.resource.data.updatedAt == request.time
          && (!exists(/databases/$(database)/documents/members/$(request.resource.data.memberUid)) || get(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data.status == 'pending')
          && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data
            .status == 'active'
          && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data
            .memberNo == request.resource.data.lastMemberNo
          && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data
            .prov == assignedProvince())
        || (isSubAdminLocal()
          && counterId == 'memberNumbers'
          && request.resource.data.keys().hasAll(
            ['next', 'lastMemberNo', 'memberUid', 'updatedAt'])
          && request.resource.data.keys().hasOnly(
            ['next', 'lastMemberNo', 'memberUid', 'updatedAt'])
          && request.resource.data.next is int
          && request.resource.data.next >= 2
          && request.resource.data.lastMemberNo is string
          && request.resource.data.lastMemberNo.matches('SM-[0-9]{4,}')
          && request.resource.data.memberUid is string
          && request.resource.data.updatedAt == request.time
          && (!exists(/databases/$(database)/documents/members/$(request.resource.data.memberUid)) || get(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data.status == 'pending')
          && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data
            .status == 'active'
          && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data
            .memberNo == request.resource.data.lastMemberNo
          && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data
            .adminStructure == assignedLocalStructure());

      allow update: if isAdmin()
        || (isSubAdmin()
          && counterId == 'memberNumbers'
          && request.resource.data.keys().hasAll(
            ['next', 'lastMemberNo', 'memberUid', 'updatedAt'])
          && request.resource.data.keys().hasOnly(
            ['next', 'lastMemberNo', 'memberUid', 'updatedAt'])
          && request.resource.data.next == resource.data.next + 1
          && request.resource.data.lastMemberNo is string
          && request.resource.data.lastMemberNo.matches('SM-[0-9]{4,}')
          && request.resource.data.memberUid is string
          && request.resource.data.updatedAt == request.time
          && (!exists(/databases/$(database)/documents/members/$(request.resource.data.memberUid)) || get(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data.status == 'pending')
          && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data
            .status == 'active'
          && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data
            .memberNo == request.resource.data.lastMemberNo
          && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data
            .prov == assignedProvince())
        // Sous-admin local : met à jour le compteur uniquement pour activer
        // un membre de SA structure (identifié par adminStructure).
        || (isSubAdminLocal()
          && counterId == 'memberNumbers'
          && request.resource.data.keys().hasAll(
            ['next', 'lastMemberNo', 'memberUid', 'updatedAt'])
          && request.resource.data.keys().hasOnly(
            ['next', 'lastMemberNo', 'memberUid', 'updatedAt'])
          && request.resource.data.next == resource.data.next + 1
          && request.resource.data.lastMemberNo is string
          && request.resource.data.lastMemberNo.matches('SM-[0-9]{4,}')
          && request.resource.data.memberUid is string
          && request.resource.data.updatedAt == request.time
          && (!exists(/databases/$(database)/documents/members/$(request.resource.data.memberUid)) || get(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data.status == 'pending')
          && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data
            .status == 'active'
          && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data
            .memberNo == request.resource.data.lastMemberNo
          && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data
            .adminStructure == assignedLocalStructure());
    }

    // ==========================================================
    // STRUCTURES LOCALES — unités de rattachement du sous-admin local
    // Créées et archivées uniquement par l'administrateur général.
    // La clé de sécurité est structureId (identifiant du document),
    // jamais le texte libre etab/province.
    // ==========================================================
    // Projection minimale des structures locales : lisible par les adhérents
    // connectés pour rattacher une demande à un structureId stable.
    // Aucune donnée de créateur ou de gestion interne n'est exposée ici.
    match /publicLocalStructures/{structureId} {
      allow read: if signedIn() && resource.data.archived == false;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'structureId','name','etab','province','archived','updatedAt'
        ])
        && request.resource.data.structureId == structureId
        && okText(request.resource.data.name,120)
        && okText(request.resource.data.etab,160)
        && okText(request.resource.data.province,40)
        && request.resource.data.archived is bool
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'structureId','name','etab','province','archived','updatedAt'
        ])
        && request.resource.data.structureId == structureId
        && okText(request.resource.data.name,120)
        && okText(request.resource.data.etab,160)
        && okText(request.resource.data.province,40)
        && request.resource.data.archived is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /localStructures/{structureId} {
      allow read: if isAdmin()
        || (isSubAdmin() && resource.data.province == assignedProvince())
        || (isSubAdminLocal() && structureId == assignedLocalStructure());

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'etab', 'province', 'structureId', 'createdBy',
          'createdAt', 'updatedAt', 'archived', 'archivedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && okText(request.resource.data.etab, 160)
        && okText(request.resource.data.province, 40)
        && request.resource.data.structureId == structureId
        && request.resource.data.structureId is string
        && request.resource.data.structureId.size() > 0
        && request.resource.data.structureId.size() <= 40
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.archived == false
        && request.resource.data.get('archivedAt', '') == '';

      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'etab', 'province', 'updatedAt', 'archived', 'archivedAt'
        ])
        && (request.resource.data.archived == true
          ? (request.resource.data.archivedAt == request.time
             && request.resource.data.keys().hasAll(['archived', 'archivedAt']))
          : (request.resource.data.get('archived', false) == false
             || request.resource.data.get('archivedAt', '') == ''))
        && okText(request.resource.data.get('name', ''), 120)
        && okText(request.resource.data.get('etab', ''), 160)
        && okText(request.resource.data.get('province', ''), 40)
        && request.resource.data.updatedAt == request.time;


    }

    // ==========================================================
    // PROPOSITIONS DE SOUS-ADMIN LOCAL — faites par le sous-admin
    // provincial, approuvées ou rejetées par l'admin général.
    // ==========================================================
    match /localAdminProposals/{proposalId} {
      allow read: if isAdmin()
        || (isSubAdmin() && resource.data.province == assignedProvince())
        || (isSubAdminLocal() && resource.data.structureId == assignedLocalStructure());

      allow create: if isSubAdmin()
        && request.resource.data.keys().hasOnly([
          'uid', 'structureId', 'province', 'proposedBy',
          'proposedAt', 'status', 'approvedBy', 'approvedAt'
        ])
        && request.resource.data.uid is string
        && request.resource.data.uid.size() > 0
        && request.resource.data.structureId is string
        && request.resource.data.structureId.size() > 0
        && request.resource.data.structureId.size() <= 40
        && request.resource.data.province == assignedProvince()
        && request.resource.data.proposedBy == request.auth.uid
        && request.resource.data.proposedAt == request.time
        && request.resource.data.status == 'pending'
        && request.resource.data.get('approvedBy', '') == ''
        && request.resource.data.get('approvedAt', '') == ''
        && exists(/databases/$(database)/documents/localStructures/$(request.resource.data.structureId))
        && get(/databases/$(database)/documents/localStructures/$(request.resource.data.structureId)).data.archived == false
        && get(/databases/$(database)/documents/localStructures/$(request.resource.data.structureId)).data.province == assignedProvince();

      allow update: if (
          (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'approvedBy', 'approvedAt', 'updatedAt'])
            && request.resource.data.status in ['approved', 'rejected']
            && request.resource.data.updatedAt == request.time
            && (
              (request.resource.data.status == 'approved'
                && request.resource.data.approvedBy == request.auth.uid
                && request.resource.data.approvedAt == request.time)
              || (request.resource.data.status == 'rejected'
                && request.resource.data.approvedBy == request.auth.uid
                && request.resource.data.approvedAt == request.time)
            ))
        || (isSubAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'cancelled'
          && request.resource.data.proposedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time));

      allow delete: if isAdmin();
    }

    match /provinceContacts/{province} {
      allow read: if isAdmin() || (isActive()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.prov == province);

      allow create: if isAdmin()
        || (isSubAdmin()
          && province == assignedProvince()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.province == province
          && request.resource.data.keys().hasOnly(['uid', 'province', 'name', 'phone'])
          && okText(request.resource.data.name, 120)
          && okText(request.resource.data.phone, 30));

      allow delete: if isAdmin()
        || (isSubAdmin()
          && province == assignedProvince()
          && (!exists(/databases/$(database)/documents/provinceContacts/$(province))
            || resource.data.uid == request.auth.uid));

      allow update: if isAdmin()
        || (isSubAdmin() && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.province == province
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone'])
          && okText(request.resource.data.name, 120)
          && okText(request.resource.data.phone, 30));
    }

    match /responsables/{respId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'title', 'phone', 'createdAt'])
        && request.resource.data.uid == respId
        && okText(request.resource.data.name, 120)
        && okText(request.resource.data.title, 60)
        && okText(request.resource.data.phone, 30);
      allow delete: if isAdmin()
        || (signedIn() && request.auth.uid == respId);
    }

    match /publicProvinceContacts/{province} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /news/{id} {
      allow read: if resource.data.audience == 'public'
        || isActive()
        || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['cat', 'date'])
        && request.resource.data.keys().hasOnly([
          'cat', 'date', 'audience', 'fr', 'ar',
          'hasImage', 'imageCount', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.cat in ['urgent', 'statut', 'events']
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.audience in ['public', 'members']
        && (request.resource.data.get('fr', null) != null
            || request.resource.data.get('ar', null) != null)
        && (request.resource.data.get('fr', null) == null
            || (request.resource.data.fr is map
                && request.resource.data.fr.keys().hasOnly(['t', 'b'])
                && okText(request.resource.data.fr.get('t', ''), 200)
                && okText(request.resource.data.fr.get('b', ''), 5000)))
        && (request.resource.data.get('ar', null) == null
            || (request.resource.data.ar is map
                && request.resource.data.ar.keys().hasOnly(['t', 'b'])
                && okText(request.resource.data.ar.get('t', ''), 200)
                && okText(request.resource.data.ar.get('b', ''), 5000)));
      allow delete: if isAdmin();
    }

    match /events/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['date'])
        && request.resource.data.keys().hasOnly([
          'date', 'time', 'fr', 'ar', 'hasImage', 'imageCount', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && okText(request.resource.data.get('time', ''), 5)
        && (request.resource.data.get('fr', null) != null
            || request.resource.data.get('ar', null) != null)
        && (request.resource.data.get('fr', null) == null
            || (request.resource.data.fr is map
                && request.resource.data.fr.keys().hasOnly(['t', 'p'])
                && okText(request.resource.data.fr.get('t', ''), 200)
                && okText(request.resource.data.fr.get('p', ''), 200)))
        && (request.resource.data.get('ar', null) == null
            || (request.resource.data.ar is map
                && request.resource.data.ar.keys().hasOnly(['t', 'p'])
                && okText(request.resource.data.ar.get('t', ''), 200)
                && okText(request.resource.data.ar.get('p', ''), 200)));
      allow delete: if isAdmin();
    }

    match /reports/{id} {
      allow read: if isAdmin()
        || (isSubAdmin() && (resource.data.province == assignedProvince() || resource.data.province == assignedProvinceLabel()))
        || (isSubAdminLocal() && resource.data.get('structureId', '') != '' && resource.data.structureId == assignedLocalStructure())
        || (signedIn() && resource.data.anonymous == false && resource.data.ownerUid == request.auth.uid);

      allow create: if (signedIn() || request.resource.data.anonymous == true)
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Seul le backend peut modifier (via Admin SDK, les règles sont bypassées)
      allow update: if false;
      allow delete: if false;
    }

    match /reportInterventions/{id} {
      allow read: if isAdmin()
        || (isSubAdmin() && (get(/databases/$(database)/documents/reports/$(resource.data.reportId)).data.province == assignedProvince() || get(/databases/$(database)/documents/reports/$(resource.data.reportId)).data.province == assignedProvinceLabel()))
        || (isSubAdminLocal() && get(/databases/$(database)/documents/reports/$(resource.data.reportId)).data.get('structureId', '') != '' && get(/databases/$(database)/documents/reports/$(resource.data.reportId)).data.structureId == assignedLocalStructure())
        || (signedIn() && get(/databases/$(database)/documents/reports/$(resource.data.reportId)).data.anonymous == false && get(/databases/$(database)/documents/reports/$(resource.data.reportId)).data.ownerUid == request.auth.uid);

      allow create: if false;  // Seul le backend peut créer

      allow update: if false;
      allow delete: if false;
    }

    match /reportAttachments/{id} {
      allow read: if isAdmin()
        || (isSubAdmin() && (resource.data.province == assignedProvince() || resource.data.province == assignedProvinceLabel()))
        || (isSubAdminLocal() && resource.data.get('structureId', '') != '' && resource.data.structureId == assignedLocalStructure())
        || (signedIn() && resource.data.anonymous == false && resource.data.ownerUid == request.auth.uid);

      allow create: if signedIn() && request.resource.data.data.size() > 0 && request.resource.data.data.size() <= 420000 && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // =========================
    // IMAGES DES COMMUNIQUÉS
    // Collectées à part pour que la liste des communiqués reste légère
    // ; l'image n'est téléchargée que quand on déplie le communiqué.
    // =========================
    match /newsImages/{id} {
      allow read: if resource.data.audience == 'public'
        || isActive()
        || isAdmin();
      allow write: if isAdmin();
    }

    // =========================
    // IMAGES DES ÉVÉNEMENTS
    // Stockées à part pour que la liste des événements reste légère.
    // =========================
    match /eventImages/{id} {
      allow read: if resource.data.audience == 'public'
        || isActive()
        || isAdmin();
      allow write: if isAdmin();
    }

    // ==========================================================
    // DEMANDES D'ADHÉSION NUMÉRIQUES — dossiers privés
    // L'adhérent dépose son dossier signé une fois ; il ne peut plus
    // le modifier ensuite. Seuls les administrateurs donnent une suite
    // (statut, note) sans jamais réécrire la pièce signée.
    // ==========================================================

    // Les champs du dossier sont exigés à la création (hasAll ci-dessous),
    // ce qui garantit que chaque lecture d'un champ est sans risque
    // d'erreur d'évaluation.
    // Clés toujours requises dans application (hasAll)
    function adhesionAppRequiredKeys() {
      return ['nom', 'prenom', 'cin', 'dob', 'phone', 'address',
              'province', 'establishment', 'service', 'function',
              'specialty', 'ppr', 'type', 'reason', 'commitment', 'date'];
    }

    // Toutes les clés autorisées dans application (hasOnly) — inclut les
    // champs conditionnels selon la branche de rattachement.
    function adhesionAppKeys() {
      return ['nom', 'prenom', 'cin', 'dob', 'phone', 'address',
              'province', 'establishment', 'service', 'function',
              'specialty', 'ppr', 'type', 'reason', 'commitment', 'date',
              'structureMere', 'rattachement', 'espaceSanitaire', 'district',
              'division', 'serviceGst', 'unite', 'serviceHospitalier',
              'directionPole', 'divisionPole', 'servicePole',
              'directionAdmin', 'divisionAdmin', 'serviceAdmin', 'niveauRattachement',
              'structureName', 'hospitalPole'];
    }

    // Province d'un sous-admin, tolérante à un profil qui n'aurait pas
    // encore le champ adminProvince.
    function adhesionSubAdminProvince() {
      return isSubAdmin()
        ? get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('adminProvince', '')
        : '';
    }

    function adhesionProvinceLabel(p) {
      return p == 'agadir' ? 'Agadir Ida-Outanane' :
             p == 'inezgane' ? 'Inezgane-Aït Melloul' :
             p == 'chtouka' ? 'Chtouka-Aït Baha' :
             p == 'taroudant' ? 'Taroudant' :
             p == 'tiznit' ? 'Tiznit' :
             p == 'tata' ? 'Tata' :
             p;
    }

    function adhesionSameProvince(a, b) {
      return adhesionProvinceLabel(a) == adhesionProvinceLabel(b);
    }

    // Un structureId non vide doit désigner une structure active de la
    // même province. Le vide est admis : le dossier reste alors provincial.
    function adhesionStructureValid(structureId, province) {
      return structureId == ''
        || (structureId is string
          && structureId.size() > 0
          && exists(/databases/$(database)/documents/localStructures/$(structureId))
          && get(/databases/$(database)/documents/localStructures/$(structureId)).data.archived == false
          && adhesionSameProvince(
            get(/databases/$(database)/documents/localStructures/$(structureId)).data.province,
            province
          ));
    }

    // Vrai quand le sous-admin en cours est celui de la province portée
    // par le dossier (la province peut être un code ou un libellé).
    function adhesionIsSubAdminOf(province) {
      return isSubAdmin()
        && (province == adhesionSubAdminProvince()
          || province == adhesionProvinceLabel(adhesionSubAdminProvince()));
    }

    // Vrai quand le sous-admin local en cours est rattaché à la structure
    // portée par le dossier d'adhésion (champ structureId).
    function adhesionIsSubAdminLocalOf(structureId) {
      return isSubAdminLocal()
        && structureId is string
        && structureId != ''
        && assignedLocalStructure() != ''
        && structureId == assignedLocalStructure();
    }

    function adhesionProvinces() {
      return ['agadir', 'inezgane', 'chtouka', 'taroudant', 'tiznit', 'tata',
              'Agadir Ida-Outanane', 'Inezgane-Aït Melloul', 'Chtouka-Aït Baha',
              'Taroudant', 'Tiznit', 'Tata'];
    }

    function adhesionTopKeys() {
      return ['uid', 'email', 'province', 'application', 'signature',
              'status', 'adminNote', 'adminSignature', 'signedBy',
              'signedAt', 'createdAt', 'updatedAt',
              'structureId', 'validatedBy', 'validatedAt', 'validatedByRole',
              'espaceSanitaire', 'district', 'division', 'serviceGst',
              'unite', 'serviceHospitalier', 'rattachement',
              'directionPole', 'divisionPole', 'servicePole',
              'directionAdmin', 'divisionAdmin', 'serviceAdmin',
              'niveauRattachement'];
    }

    // Contenu du dossier (application) : toutes les clés attendues,
    // aucune en trop, textes bornés, province cohérente, engagement
    // assumé, motif obligatoire pour un renouvellement.
    // Partagé entre la création ET le renvoi après demande de complément
    // : les deux parcours appliquent exactement les mêmes exigences.
    // 'service' et 'function' sont des mots-clés du langage de règles :
    // accès par crochets obligatoire. hasAll est évalué en premier et
    // les opérateurs && courts-circuitent : aucun accès à risque.
    function adhesionAppOk(app, province) {
      return app is map
        && app.keys().hasAll(adhesionAppRequiredKeys())
        && app.keys().hasOnly(adhesionAppKeys())
        && okText(app.nom, 100)
        && app.nom.size() > 0
        && okText(app.prenom, 100)
        && app.prenom.size() > 0
        && okText(app.cin, 30)
        && app.cin.size() > 0
        && okText(app.dob, 10)
        && okText(app.phone, 30)
        && app.phone.size() > 0
        && okText(app.address, 250)
        && app.address.size() > 0
        && okText(app.establishment, 160)
        && okText(app.get('structureName', ''), 120)
        && okText(app.get('hospitalPole', ''), 120)
        && app.get('hospitalPole', '') in ['', 'Pôle des affaires médicales (PAM)', 'Pôle des soins infirmiers (PSI)', 'Pôle des affaires administratives (PAA)']
        && ((app.get('rattachement', '') in ['pole', 'dgaAdministrative'] && app.establishment == '')
          || app.establishment.size() > 0)
        && okText(app['service'], 120)
        && okText(app['function'], 120)
        && app['function'].size() > 0
        && okText(app.specialty, 120)
        && okText(app.ppr, 30)
        && okText(app.get('rattachement', ''), 40)
        && app.get('rattachement', '') in ['', 'pole', 'dgaSanitaire', 'dgaAdministrative']
        && okText(app.get('espaceSanitaire', ''), 120)
        && okText(app.get('district', ''), 120)
        && okText(app.get('division', ''), 120)
        && okText(app.get('serviceGst', ''), 120)
        && okText(app.get('unite', ''), 120)
        && okText(app.get('serviceHospitalier', ''), 160)
        && okText(app.get('directionPole', ''), 120)
        && okText(app.get('divisionPole', ''), 120)
        && okText(app.get('servicePole', ''), 120)
        && okText(app.get('directionAdmin', ''), 120)
        && okText(app.get('divisionAdmin', ''), 120)
        && okText(app.get('serviceAdmin', ''), 120)
        && okText(app.get('niveauRattachement', ''), 40)
        && (app.get('rattachement', '') != '' || app.get('niveauRattachement', '') == '')
        && app.get('niveauRattachement', '') in ['', 'direction', 'divisionDirecte', 'serviceDirect', 'division']
        && (app.get('rattachement', '') != 'pole' || app.get('niveauRattachement', '') in ['direction', 'divisionDirecte', 'serviceDirect'])
        && (app.get('rattachement', '') != 'dgaAdministrative' || app.get('niveauRattachement', '') in ['direction', 'serviceDirect'])
        && (app.get('rattachement', '') != 'pole' ||
          ((app.get('niveauRattachement', '') == 'direction'
              && app.get('directionPole', '').size() > 0
              && app.get('divisionPole', '').size() > 0
              && app.get('servicePole', '').size() > 0)
            || (app.get('niveauRattachement', '') == 'divisionDirecte'
              && app.get('divisionPole', '').size() > 0
              && app.get('servicePole', '').size() > 0)
            || (app.get('niveauRattachement', '') == 'serviceDirect'
              && app.get('servicePole', '').size() > 0)))
        && (app.get('rattachement', '') != 'dgaAdministrative' ||
          ((app.get('niveauRattachement', '') == 'direction'
              && app.get('directionAdmin', '').size() > 0
              && app.get('divisionAdmin', '').size() > 0
              && app.get('serviceAdmin', '').size() > 0)
            || (app.get('niveauRattachement', '') == 'serviceDirect'
              && app.get('serviceAdmin', '').size() > 0)))
        && (app.get('rattachement', '') != 'dgaSanitaire' ||
          (app.get('espaceSanitaire', '').size() > 0
            && app.get('district', '').size() > 0
            && ((app.get('niveauRattachement', '') == ''
                && (app.get('serviceGst', '').size() > 0
                  || app.get('unite', '').size() > 0
                  || app.get('serviceHospitalier', '').size() > 0))
              || (app.get('niveauRattachement', '') == 'division'
                && app.get('division', '').size() > 0
                && app.get('serviceGst', '').size() > 0)
              || (app.get('niveauRattachement', '') == 'serviceDirect'
                && app.get('serviceGst', '').size() > 0))))
        && app.province == province
        && app.commitment == true
        && app.type in ['first', 'renewal']
        && okText(app.reason, 200)
        && ((app.type == 'first' && app.reason == '')
          || (app.type == 'renewal' && app.reason.size() > 0));
    }

    match /adhesionRequests/{uid} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == uid)
        || adhesionIsSubAdminOf(resource.data.get('province', ''))
        || adhesionIsSubAdminLocalOf(resource.data.get('structureId', ''));

      // hasAll exige la présence de toutes les clés attendues : les
      // accès aux champs qui suivent ne peuvent donc jamais lever
      // d'erreur d'évaluation.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'province', 'application', 'signature',
          'status', 'adminNote', 'createdAt', 'updatedAt'
        ])
  && request.resource.data.keys().hasOnly([
    'uid', 'email', 'province', 'application', 'signature',
    'status', 'adminNote', 'createdAt', 'updatedAt',
    'structureId', 'espaceSanitaire', 'district',
    'division', 'serviceGst',
    'unite', 'serviceHospitalier',
    'rattachement', 'directionPole', 'divisionPole', 'servicePole',
    'directionAdmin', 'divisionAdmin', 'serviceAdmin', 'niveauRattachement'
  ])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.adminNote == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && okText(request.resource.data.get('structureId', ''), 40)
        && adhesionStructureValid(request.resource.data.get('structureId', ''), request.resource.data.province)
        && (request.resource.data.get('rattachement', '') != 'dgaSanitaire'
            || request.resource.data.province in adhesionProvinces())
        && okText(request.resource.data.email, 254)
        && request.resource.data.signature is string
        && request.resource.data.signature.size() > 0
        && request.resource.data.signature.size() <= 20000
        && adhesionAppOk(request.resource.data.application,
                         request.resource.data.province);

      // ADHESION_UPDATE_RESTRICTED_FIELDS : le dossier signé par l'adhérent
      // n'est JAMAIS réécrit par un responsable. Seuls le statut, la note
      // administrative et la signature électronique du responsable bougent.
      // Une signature ne peut être posée qu'avec le statut 'accepted'
      // (signer = valider l'adhésion), par le responsable qui la produit,
      // et horodatée au moment de l'écriture.
      // Réservé aux administrateurs, sous-admins provinciaux et locaux.
      allow update: if (
          (isAdmin() || adhesionIsSubAdminOf(resource.data.get('province', ''))
              || adhesionIsSubAdminLocalOf(resource.data.get('structureId', '')))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'adminNote', 'adminSignature', 'signedBy', 'signedAt', 'updatedAt',
                      'structureId', 'validatedBy', 'validatedAt', 'validatedByRole'])
          && request.resource.data.get('structureId', '') == resource.data.get('structureId', '')
          && request.resource.data.status in ['pending', 'needs_completion', 'accepted', 'refused']
          && okText(request.resource.data.adminNote, 1000)
          && request.resource.data.updatedAt == request.time
          && (
            // Décision simple : complément demandé, refus, remise en attente.
            // Seuls status, adminNote et updatedAt peuvent changer ; les
            // autres champs doivent rester à leur valeur par défaut.
            // 'accepted' N'EST PAS autorisé ici : il faut passer par les branches
            // de validation avec signature (admin) ou validatedBy (subadminLocal).
            // structureId reste immuable pour les responsables ; il peut être vide
            // lorsqu'aucune structure locale n'est déclarée (traitement provincial).
            request.resource.data.status != 'accepted'
            && request.resource.data.get('adminSignature', '') == ''
            && request.resource.data.get('signedBy', '') == ''
            && request.resource.data.get('signedAt', '') == ''
            && request.resource.data.get('validatedBy', '') == ''
            && request.resource.data.get('validatedAt', '') == ''
            && request.resource.data.get('validatedByRole', '') == ''
            || (
              // Validation par l'administrateur général ou le sous-admin de province
              // (signature électronique = validation de l'adhésion).
              (isAdmin() || adhesionIsSubAdminOf(resource.data.get('province', '')))
              && request.resource.data.status == 'accepted'
              && request.resource.data.adminSignature is string
              && request.resource.data.adminSignature.size() > 0
              && request.resource.data.adminSignature.size() <= 20000
              && request.resource.data.signedBy == request.auth.uid
              && request.resource.data.signedAt == request.time
              && request.resource.data.get('validatedBy', '') == '')
            || (
              // Validation par le sous-admin local de la structure du dossier
              // (traces de validation : validatedBy/validatedAt/validatedByRole).
              adhesionIsSubAdminLocalOf(resource.data.get('structureId', ''))
              && request.resource.data.status == 'accepted'
              && okText(request.resource.data.validatedBy, 120)
              && request.resource.data.validatedBy.size() > 0
              && request.resource.data.validatedBy == request.auth.uid
              && request.resource.data.validatedAt == request.time
              && okText(request.resource.data.validatedByRole, 60)
              && request.resource.data.validatedByRole == 'subadminLocal'
              && request.resource.data.get('adminSignature', '') == '')
          )
        );

      // Renvoi par l'adhérent : complément demandé (needs_completion)
      // OU renouvellement après acceptation (accepted + type renewal,
      // motif exigé par adhesionAppOk). Le dossier repasse en pending
      // avec application, signature et PDF ré-validés intégralement
      // (mêmes exigences qu'à la création via adhesionAppOk).
      // Province, e-mail et date de création restent figés ; la note
      // du responsable est effacée.
      // La signature du responsable de la soumission précédente est
      // elle aussi effacée : un renouvellement repart avec UNE seule
      // signature (celle de l'adhérent), la case du responsable à
      // valider. Elle ne peut qu'être VIDÉE, jamais posée.
      // Réservé à l'adhérent propriétaire du dossier.
      allow update: if (
          signedIn() && request.auth.uid == uid
          && resource.data.uid == uid
          && resource.data.status in ['needs_completion', 'accepted']
          && request.resource.data.keys().hasOnly(adhesionTopKeys())
          && (resource.data.status == 'needs_completion'
            || request.resource.data.application.type == 'renewal')
          && request.resource.data.uid == uid
        && (request.resource.data.get('rattachement', '') != 'dgaSanitaire'
            || request.resource.data.province in adhesionProvinces())
          && request.resource.data.province == resource.data.province
          && okText(request.resource.data.get('structureId', ''), 40)
          && adhesionStructureValid(request.resource.data.get('structureId', ''), request.resource.data.province)
          && request.resource.data.email == resource.data.email
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.status == 'pending'
          && request.resource.data.adminNote == ''
            && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['application', 'signature', 'status', 'adminNote',
                      'adminSignature', 'signedBy', 'signedAt', 'updatedAt',
                      'structureId', 'espaceSanitaire', 'district',
                      'division', 'serviceGst',
                      'unite', 'serviceHospitalier',
                      'rattachement', 'directionPole', 'divisionPole', 'servicePole',
                      'directionAdmin', 'divisionAdmin', 'serviceAdmin', 'niveauRattachement'])
          && request.resource.data.get('adminSignature', '') == ''
          && request.resource.data.get('signedBy', '') == ''
          && request.resource.data.get('signedAt', '') == ''
          && okText(request.resource.data.email, 254)
          && request.resource.data.signature is string
          && request.resource.data.signature.size() > 0
          && request.resource.data.signature.size() <= 20000
          && adhesionAppOk(request.resource.data.application,
                           request.resource.data.province)
        );

      allow delete: if isAdmin();
    }

    // ==========================================================
    // PDF SIGNÉ DES DEMANDES D'ADHÉSION
    // Pièce jointe du dossier : refusée si aucune demande n'existe
    // pour ce compte, ou si sa province ne correspond pas.
    // ==========================================================
    match /adhesionDocuments/{uid} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == uid)
        || adhesionIsSubAdminOf(resource.data.get('province', ''))
        || adhesionIsSubAdminLocalOf(resource.data.get('structureId', ''));

      // Le PDF officiel n'est JAMAIS écrit par l'adhérent : il est généré
      // par un responsable habilité (administrateur général, sous-admin
      // de province, ou sous-admin local), sur action explicite, et uniquement
      // pour une demande déjà VALIDÉE : statut 'accepted', avec soit :
      // - signature du responsable (signedBy + adminSignature) pour validation provinciale
      // - validation locale (validatedBy + validatedAt + validatedByRole='subadminLocal')
      // La régénération est permise : le PDF reste toujours aligné sur l'état validé.
      allow create, update: if (isAdmin()
          || adhesionIsSubAdminOf(request.resource.data.get('province', ''))
          || adhesionIsSubAdminLocalOf(request.resource.data.get('structureId', '')))
        && request.resource.data.keys().hasOnly([
          'uid', 'province', 'structureId', 'fileName', 'mimeType', 'data',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.province in adhesionProvinces()
        && okText(request.resource.data.structureId, 40)
        && (
          // Sans structure locale déclarée : seul l'admin général ou le
          // sous-admin de province peut enregistrer le PDF.
          (request.resource.data.structureId == ''
            && (isAdmin() || adhesionIsSubAdminOf(request.resource.data.province)))
          ||
          // Avec structure : elle doit exister et être active pour le
          // sous-admin local. L'admin général/la province peut terminer
          // un dossier si la structure a été archivée après son dépôt.
          (request.resource.data.structureId.size() > 0
            && exists(/databases/$(database)/documents/localStructures/$(request.resource.data.structureId))
            && (
              get(/databases/$(database)/documents/localStructures/$(request.resource.data.structureId)).data.archived == false
              || isAdmin()
              || adhesionIsSubAdminOf(request.resource.data.province)
            )
            && adhesionSameProvince(
              get(/databases/$(database)/documents/localStructures/$(request.resource.data.structureId)).data.province,
              request.resource.data.province
            ))
        )
        && okText(request.resource.data.fileName, 120)
        && request.resource.data.mimeType == 'application/pdf'
        && request.resource.data.data is string
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 200000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/adhesionRequests/$(uid))
        && get(/databases/$(database)/documents/adhesionRequests/$(uid)).data.uid == uid
        && get(/databases/$(database)/documents/adhesionRequests/$(uid)).data.province
          == request.resource.data.province
        && get(/databases/$(database)/documents/adhesionRequests/$(uid)).data.structureId
          == request.resource.data.structureId
        && get(/databases/$(database)/documents/adhesionRequests/$(uid)).data.status
          == 'accepted'
        && (
          // Validation provinciale : signature du responsable
          (get(/databases/$(database)/documents/adhesionRequests/$(uid)).data
            .get('signedBy', '') is string
          && get(/databases/$(database)/documents/adhesionRequests/$(uid)).data
            .get('signedBy', '').size() > 0
          && get(/databases/$(database)/documents/adhesionRequests/$(uid)).data
            .get('adminSignature', '').size() > 0)
          ||
          // Validation locale : traces validatedBy
          (get(/databases/$(database)/documents/adhesionRequests/$(uid)).data
            .get('validatedBy', '') is string
          && get(/databases/$(database)/documents/adhesionRequests/$(uid)).data
            .get('validatedBy', '').size() > 0
          && get(/databases/$(database)/documents/adhesionRequests/$(uid)).data
            .get('validatedByRole', '') == 'subadminLocal')
        );

      allow delete: if isAdmin();
    }

  // Le bloc notifications doit être un enfant de
  // match /databases/{database}/documents : placé plus bas (après la
  // fermeture de documents) il serait hors de l'arbre et jamais atteint.
  match /notifications/{uid}/items/{id} {
    allow read: if signedIn() && request.auth.uid == uid;
    allow create: if signedIn()
      && (isAdmin() || (isSubAdmin() && get(/databases/$(database)/documents/members/$(uid)).data.prov == assignedProvince()))
      && request.resource.data.read == false
      && request.resource.data.authorUid == request.auth.uid
      && request.resource.data.title is string && request.resource.data.title.size() <= 120
      && request.resource.data.body is string && request.resource.data.body.size() <= 500
      && request.resource.data.type in ['info','adhesion','event','news','report','adhesion_request','adhesion_renewal','dialogue']
      && request.resource.data.createdAt == request.time
      && request.resource.data.keys().hasOnly(['title','body','createdAt','read','type','targetScreen','targetId','authorUid','province','targetType']);
    allow update: if signedIn() && request.auth.uid == uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
      && request.resource.data.read is bool;
    allow delete: if isAdmin();
  }

  match /fcmTokens/{uid} {
    allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
    allow create, update: if signedIn() && request.auth.uid == uid
      && request.resource.data.token is string
      && request.resource.data.token.size() > 0
      && request.resource.data.updatedAt == request.time;
    allow delete: if signedIn() && request.auth.uid == uid;
  }

  // Statistiques de fréquentation : lecture strictement réservée à l'administrateur général.
  match /analyticsStats/{statId} {
    allow read: if isAdmin();
    allow create, update: if statId.matches('(summary|daily-[0-9]{4}-[0-9]{2}-[0-9]{2}|weekly-[0-9]{4}-W[0-9]{2}|monthly-[0-9]{4}-[0-9]{2})')
      && request.resource.data.keys().hasOnly(['totalVisits','totalVisitsAuth','totalVisitsAnon','uniqueVisitors','uniqueAuth','uniqueAnon','date','week','month','updatedAt'])
      && request.resource.data.updatedAt == request.time;
    allow delete: if isAdmin();
  }

  match /analyticsPresence/{visitorId} {
    allow read: if isAdmin();
    allow create, update: if visitorId.size() >= 8 && visitorId.size() <= 80
      && request.resource.data.keys().hasOnly(['lastSeen','auth'])
      && request.resource.data.lastSeen == request.time
      && request.resource.data.auth is bool;
    allow delete: if isAdmin();
  }

  }

}
