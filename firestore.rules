rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['abaray66@gmail.com'];
    }

    function isSubAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'subadmin';
    }

    function assignedProvince() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.adminProvince;
    }

    function assignedProvinceLabel() {
      return assignedProvince() == 'agadir' ? 'Agadir Ida-Outanane' :
             assignedProvince() == 'inezgane' ? 'Inezgane-Aït Melloul' :
             assignedProvince() == 'chtouka' ? 'Chtouka-Aït Baha' :
             assignedProvince() == 'taroudant' ? 'Taroudant' :
             assignedProvince() == 'tiznit' ? 'Tiznit' :
             assignedProvince() == 'tata' ? 'Tata' :
             assignedProvince();
    }

    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'active';
    }

    function okText(v, max) {
      return v is string && v.size() <= max;
    }

    match /members/{uid} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == uid)
        || (isSubAdmin() && resource.data.prov == assignedProvince());

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'photo', 'etab', 'prov',
          'phone', 'status', 'createdAt'
        ])
        && okText(request.resource.data.name, 120)
        && okText(request.resource.data.etab, 160)
        && okText(request.resource.data.prov, 40)
        && okText(request.resource.data.phone, 30);

      allow update: if isAdmin()
        || (isSubAdmin() && resource.data.prov == assignedProvince()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'memberNo', 'activatedAt'])
            && okText(request.resource.data.memberNo, 30))
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'etab', 'prov', 'phone', 'updatedAt'])
            && okText(request.resource.data.name, 120)
            && okText(request.resource.data.etab, 160)
            && okText(request.resource.data.prov, 40)
            && okText(request.resource.data.phone, 30));

      allow delete: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && resource.data.get('role', 'member') != 'subadmin');
    }

    match /provinceContacts/{province} {
      // Le numéro du responsable est partagé uniquement avec les adhérents actifs de son secteur.
      allow read: if isAdmin() || (isActive()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.prov == province);
      allow create: if isAdmin()
        || (isSubAdmin()
          && province == assignedProvince()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.province == province
          && request.resource.data.keys().hasOnly(['uid', 'province', 'name', 'phone'])
          && okText(request.resource.data.name, 120)
          && okText(request.resource.data.phone, 30));

      allow delete: if isAdmin();

      allow update: if isAdmin()
        || (isSubAdmin() && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.province == province
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone'])
          && okText(request.resource.data.name, 120)
          && okText(request.resource.data.phone, 30));
    }

    match /news/{id} {
      allow read: if resource.data.audience == 'public'
        || isActive()
        || isAdmin();

      allow write: if isAdmin();
    }

    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================
    // SIGNALEMENTS
    // =========================

    match /reports/{id} {

      // Un membre peut lire uniquement ses propres signalements.
      // L'administrateur peut tous les lire.
      allow read: if isAdmin()
        || (isSubAdmin() && resource.data.province == assignedProvinceLabel())
        || (
          signedIn()
          && resource.data.anonymous == false
          && resource.data.ownerUid == request.auth.uid
        );

      // Création d'un signalement
      allow create: if request.resource.data.keys().hasOnly([
          'ownerUid',
          'anonymous',
          'name',
          'etab',
          'age',
          'da',
          'category',
          'description',
          'date',
          'province',
          'attachmentName',
          'attachmentType',
          'attachmentData',
          'status',
          'response',
          'createdAt',
          'updatedAt'
        ])

        && request.resource.data.status == 'new'
        && request.resource.data.response == ''

        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time

        && request.resource.data.anonymous is bool

        && request.resource.data.name is string
        && request.resource.data.etab is string
        && request.resource.data.age is string
        && request.resource.data.da is string
        && request.resource.data.category is string
        && request.resource.data.description is string
        && request.resource.data.date is string
        && request.resource.data.province is string
        && request.resource.data.province in [
          'Agadir Ida-Outanane',
          'Inezgane-Aït Melloul',
          'Chtouka-Aït Baha',
          'Taroudant',
          'Tiznit',
          'Tata'
        ]

        && request.resource.data.attachmentName is string
        && request.resource.data.attachmentType is string
        && request.resource.data.attachmentData is string

        && okText(request.resource.data.name, 120)
        && okText(request.resource.data.etab, 160)
        && okText(request.resource.data.age, 3)
        && okText(request.resource.data.da, 80)
        && okText(request.resource.data.category, 60)
        && okText(request.resource.data.description, 4000)
        && okText(request.resource.data.date, 20)

        && okText(request.resource.data.attachmentName, 120)
        && okText(request.resource.data.attachmentType, 80)
        && okText(request.resource.data.attachmentData, 420000)

        // Signalement anonyme :
        // aucune identité ni UID n'est enregistré.
        && (
          (
            request.resource.data.anonymous == true
            && request.resource.data.ownerUid == ''
            && request.resource.data.name == ''
          )

          ||

          // Signalement identifié :
          // il est lié au compte de l'utilisateur.
          (
            signedIn()
            && request.resource.data.anonymous == false
            && request.resource.data.ownerUid == request.auth.uid
          )
        );

      // L'administrateur général voit tout ; le sous-admin gère son secteur.
      allow update: if isAdmin()
        || (isSubAdmin()
          && resource.data.province == assignedProvinceLabel()
          && request.resource.data.status in ['new', 'in_progress', 'closed']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'response', 'updatedAt'])
          && okText(request.resource.data.response, 3000));

      // Seul l'administrateur peut supprimer un signalement.
      allow delete: if isAdmin();
    }
  }
}
