rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminEmails() {
      return ['abaray66@gmail.com'];
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in adminEmails();
    }

    function isSubAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'subadmin';
    }

    function assignedProvince() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.adminProvince;
    }

    function assignedProvinceLabel() {
      return assignedProvince() == 'agadir' ? 'Agadir Ida-Outanane' :
             assignedProvince() == 'inezgane' ? 'Inezgane-Aït Melloul' :
             assignedProvince() == 'chtouka' ? 'Chtouka-Aït Baha' :
             assignedProvince() == 'taroudant' ? 'Taroudant' :
             assignedProvince() == 'tiznit' ? 'Tiznit' :
             assignedProvince() == 'tata' ? 'Tata' :
             assignedProvince();
    }

    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'active';
    }

    function okText(v, max) {
      return v is string && v.size() <= max;
    }

    match /members/{uid} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == uid)
        || (isSubAdmin() && resource.data.prov == assignedProvince());

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'photo', 'etab', 'prov',
          'phone', 'status', 'createdAt'
        ])
        && okText(request.resource.data.name, 120)
        && okText(request.resource.data.etab, 160)
        && okText(request.resource.data.prov, 40)
        && okText(request.resource.data.phone, 30)
        || ((isAdmin()
            || (isSubAdmin() && request.resource.data.prov == assignedProvince()
                && request.resource.data.role == 'member'
                && request.resource.data.adminProvince == assignedProvince()))
            && request.resource.data.status == 'active'
            && request.resource.data.keys().hasOnly([
              'name', 'email', 'photo', 'etab', 'prov',
              'phone', 'status', 'memberNo', 'activatedAt', 'createdAt',
              'role', 'adminProvince'
            ])
            && okText(request.resource.data.name, 120)
            && okText(request.resource.data.email, 254)
            && okText(request.resource.data.etab, 160)
            && okText(request.resource.data.prov, 40)
            && okText(request.resource.data.phone, 30)
            && okText(request.resource.data.memberNo, 30)
            && request.resource.data.memberNo.matches('SM-[0-9]{4,}')
            && getAfter(/databases/$(database)/documents/counters/memberNumbers).data
              .lastMemberNo == request.resource.data.memberNo);

      allow update: if isAdmin()
        || (isSubAdmin() && resource.data.prov == assignedProvince()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'email', 'photo', 'etab', 'prov',
                'phone', 'status', 'memberNo', 'activatedAt', 'updatedAt'])
            && okText(request.resource.data.name, 120)
            && okText(request.resource.data.email, 254)
            && okText(request.resource.data.etab, 160)
            && okText(request.resource.data.prov, 40)
            && okText(request.resource.data.phone, 30)
            && okText(request.resource.data.memberNo, 30)
            && request.resource.data.memberNo.matches('SM-[0-9]{4,}')
            && getAfter(/databases/$(database)/documents/counters/memberNumbers).data
                 .lastMemberNo == request.resource.data.memberNo)
        || (isSubAdmin() && resource.data.prov == assignedProvince()
            && resource.data.status == 'active'
            && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'email', 'photo', 'etab', 'prov', 'phone', 'updatedAt'])
            && okText(request.resource.data.name, 120)
            && okText(request.resource.data.email, 254)
            && okText(request.resource.data.etab, 160)
            && okText(request.resource.data.prov, 40)
            && okText(request.resource.data.phone, 30))
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'etab', 'phone', 'updatedAt'])
            && okText(request.resource.data.name, 120)
            && okText(request.resource.data.etab, 160)
            && okText(request.resource.data.prov, 40)
            && okText(request.resource.data.phone, 30));

      allow delete: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && (!('role' in resource.data) || resource.data.role != 'subadmin'));
    }

    match /counters/{counterId} {
      allow read: if isAdmin() || isSubAdmin();
      allow create: if isAdmin()
        || (isSubAdmin()
          && counterId == 'memberNumbers'
          && request.resource.data.keys().hasAll(['next', 'lastMemberNo', 'memberUid', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['next', 'lastMemberNo', 'memberUid', 'updatedAt'])
          && request.resource.data.next is int
          && request.resource.data.next >= 2
          && request.resource.data.lastMemberNo is string
          && request.resource.data.lastMemberNo.matches('SM-[0-9]{4,}')
          && request.resource.data.memberUid is string
          && request.resource.data.updatedAt == request.time
          && (!exists(/databases/$(database)/documents/members/$(request.resource.data.memberUid)) || get(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data.status == 'pending')
          && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data.status == 'active'
          && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data.memberNo == request.resource.data.lastMemberNo
          && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data.prov == assignedProvince());
      allow update: if isAdmin()
        || (isSubAdmin()
          && counterId == 'memberNumbers'
          && request.resource.data.keys().hasAll(['next', 'lastMemberNo', 'memberUid', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['next', 'lastMemberNo', 'memberUid', 'updatedAt'])
          && request.resource.data.next == resource.data.next + 1
          && request.resource.data.lastMemberNo is string
          && request.resource.data.lastMemberNo.matches('SM-[0-9]{4,}')
          && request.resource.data.memberUid is string
          && request.resource.data.updatedAt == request.time
          && (!exists(/databases/$(database)/documents/members/$(request.resource.data.memberUid)) || get(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data.status == 'pending')
          && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data.status == 'active'
          && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data.memberNo == request.resource.data.lastMemberNo
          && getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data.prov == assignedProvince());
    }

    match /provinceContacts/{province} {
      allow read: if isAdmin() || (isActive() && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.prov == province);
      allow create: if isAdmin() || (isSubAdmin() && province == assignedProvince() && request.resource.data.uid == request.auth.uid && request.resource.data.province == province && request.resource.data.keys().hasOnly(['uid', 'province', 'name', 'phone']) && okText(request.resource.data.name, 120) && okText(request.resource.data.phone, 30));
      allow delete: if isAdmin() || (isSubAdmin() && province == assignedProvince() && (!exists(/databases/$(database)/documents/provinceContacts/$(province)) || resource.data.uid == request.auth.uid));
      allow update: if isAdmin() || (isSubAdmin() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid && request.resource.data.province == province && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone']) && okText(request.resource.data.name, 120) && okText(request.resource.data.phone, 30));
    }

    match /responsables/{respId} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['uid', 'name', 'title', 'phone', 'createdAt']) && request.resource.data.uid == respId && okText(request.resource.data.name, 120) && okText(request.resource.data.title, 60) && okText(request.resource.data.phone, 30);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == respId);
    }

    match /publicProvinceContacts/{province} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /news/{id} {
      allow read: if resource.data.audience == 'public' || isActive() || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['cat', 'date'])
        && request.resource.data.keys().hasOnly(['cat', 'date', 'audience', 'fr', 'ar', 'hasImage', 'createdAt', 'updatedAt'])
        && request.resource.data.cat in ['urgent', 'statut', 'events']
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.audience in ['public', 'members']
        && (request.resource.data.get('fr', null) != null || request.resource.data.get('ar', null) != null)
        && (request.resource.data.get('fr', null) == null || (request.resource.data.fr is map && request.resource.data.fr.keys().hasOnly(['t', 'b']) && okText(request.resource.data.fr.get('t', ''), 200) && okText(request.resource.data.fr.get('b', ''), 5000)))
        && (request.resource.data.get('ar', null) == null || (request.resource.data.ar is map && request.resource.data.ar.keys().hasOnly(['t', 'b']) && okText(request.resource.data.ar.get('t', ''), 200) && okText(request.resource.data.ar.get('b', ''), 5000)));
      allow delete: if isAdmin();
    }

    match /events/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['date'])
        && request.resource.data.keys().hasOnly(['date', 'time', 'fr', 'ar', 'createdAt', 'updatedAt'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && okText(request.resource.data.get('time', ''), 5)
        && (request.resource.data.get('fr', null) != null || request.resource.data.get('ar', null) != null)
        && (request.resource.data.get('fr', null) == null || (request.resource.data.fr is map && request.resource.data.fr.keys().hasOnly(['t', 'p']) && okText(request.resource.data.fr.get('t', ''), 200) && okText(request.resource.data.fr.get('p', ''), 200)))
        && (request.resource.data.get('ar', null) == null || (request.resource.data.ar is map && request.resource.data.ar.keys().hasOnly(['t', 'p']) && okText(request.resource.data.ar.get('t', ''), 200) && okText(request.resource.data.ar.get('p', ''), 200)));
      allow delete: if isAdmin();
    }

    match /reports/{id} {
      allow read: if isAdmin() || (isSubAdmin() && resource.data.province == assignedProvinceLabel()) || (signedIn() && resource.data.anonymous == false && resource.data.ownerUid == request.auth.uid);
      allow create: if request.resource.data.keys().hasOnly(['ownerUid','anonymous','name','etab','age','da','category','description','date','province','attachmentName','attachmentType','attachmentData','attachmentCount','status','response','createdAt','updatedAt'])
        && request.resource.data.status == 'new' && request.resource.data.response == ''
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.anonymous is bool && request.resource.data.name is string && request.resource.data.etab is string && request.resource.data.age is string && request.resource.data.da is string && request.resource.data.category is string && request.resource.data.description is string && request.resource.data.date is string && request.resource.data.province is string
        && request.resource.data.province in ['Agadir Ida-Outanane','Inezgane-Aït Melloul','Chtouka-Aït Baha','Taroudant','Tiznit','Tata']
        && request.resource.data.attachmentName is string && request.resource.data.attachmentType is string && request.resource.data.attachmentCount is int && request.resource.data.attachmentCount >= 0 && request.resource.data.attachmentCount <= 3 && request.resource.data.attachmentData is string
        && okText(request.resource.data.name, 120) && okText(request.resource.data.etab, 160) && okText(request.resource.data.age, 10) && okText(request.resource.data.da, 80) && okText(request.resource.data.category, 60) && okText(request.resource.data.description, 4000)
        && request.resource.data.description.size() >= 10 && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && okText(request.resource.data.date, 20) && okText(request.resource.data.attachmentName, 120) && okText(request.resource.data.attachmentType, 80) && okText(request.resource.data.attachmentData, 420000)
        && ((request.resource.data.anonymous == true && request.resource.data.ownerUid == '' && request.resource.data.name == '' && request.resource.data.age == '') || (signedIn() && request.resource.data.anonymous == false && request.resource.data.ownerUid == request.auth.uid));
      allow update: if isAdmin() || (isSubAdmin() && resource.data.province == assignedProvinceLabel() && request.resource.data.status in ['new','in_progress','closed'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','response','updatedAt']) && okText(request.resource.data.response, 3000));
      allow delete: if isAdmin();
    }

    match /reportAttachments/{id} {
      allow read: if isAdmin() || (isSubAdmin() && resource.data.province == assignedProvinceLabel()) || (signedIn() && resource.data.anonymous == false && resource.data.ownerUid == request.auth.uid);
      allow create: if request.resource.data.keys().hasOnly(['ownerUid','anonymous','province','name','type','data','createdAt'])
        && request.resource.data.createdAt == request.time && request.resource.data.anonymous is bool && request.resource.data.ownerUid is string && request.resource.data.province is string
        && request.resource.data.province in ['Agadir Ida-Outanane','Inezgane-Aït Melloul','Chtouka-Aït Baha','Taroudant','Tiznit','Tata']
        && request.resource.data.name is string && request.resource.data.type is string && request.resource.data.data is string
        && okText(request.resource.data.name, 120) && okText(request.resource.data.type, 80) && okText(request.resource.data.data, 420000)
        && ((request.resource.data.anonymous == true && request.resource.data.ownerUid == '') || (signedIn() && request.resource.data.anonymous == false && request.resource.data.ownerUid == request.auth.uid));
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /newsImages/{id} {
      allow read: if resource.data.audience == 'public' || isActive() || isAdmin();
      allow write: if isAdmin();
    }

    function adhesionAppKeys() {
      return ['nom', 'prenom', 'cin', 'dob', 'phone', 'address', 'province', 'establishment', 'service', 'function', 'specialty', 'ppr', 'type', 'reason', 'commitment', 'date'];
    }
    function adhesionSubAdminProvince() {
      return isSubAdmin() ? get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('adminProvince', '') : '';
    }
    function adhesionProvinceLabel(p) {
      return p == 'agadir' ? 'Agadir Ida-Outanane' : p == 'inezgane' ? 'Inezgane-Aït Melloul' : p == 'chtouka' ? 'Chtouka-Aït Baha' : p == 'taroudant' ? 'Taroudant' : p == 'tiznit' ? 'Tiznit' : p == 'tata' ? 'Tata' : p;
    }
    function adhesionIsSubAdminOf(province) {
      return isSubAdmin() && (province == adhesionSubAdminProvince() || province == adhesionProvinceLabel(adhesionSubAdminProvince()));
    }
    function adhesionProvinces() {
      return ['agadir', 'inezgane', 'chtouka', 'taroudant', 'tiznit', 'tata', 'Agadir Ida-Outanane', 'Inezgane-Aït Melloul', 'Chtouka-Aït Baha', 'Taroudant', 'Tiznit', 'Tata'];
    }
    function adhesionTopKeys() {
      return ['uid', 'email', 'province', 'application', 'signature', 'status', 'adminNote', 'adminSignature', 'signedBy', 'signedAt', 'createdAt', 'updatedAt'];
    }
    function adhesionAppOk(app, province) {
      return app is map
        && app.keys().hasAll(adhesionAppKeys())
        && app.keys().hasOnly(adhesionAppKeys())
        && okText(app.nom, 100) && app.nom.size() > 0
        && okText(app.prenom, 100) && app.prenom.size() > 0
        && okText(app.cin, 30) && app.cin.size() > 0
        && okText(app.dob, 10)
        && okText(app.phone, 30) && app.phone.size() > 0
        && okText(app.address, 250) && app.address.size() > 0
        && okText(app.establishment, 160) && app.establishment.size() > 0
        && okText(app['service'], 120)
        && okText(app['function'], 120) && app['function'].size() > 0
        && okText(app.specialty, 120)
        && okText(app.ppr, 30)
        && app.province == province
        && app.commitment == true
        && app.type in ['first', 'renewal']
        && okText(app.reason, 200)
        && ((app.type == 'first' && app.reason == '') || (app.type == 'renewal' && app.reason.size() > 0));
    }

    match /adhesionRequests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid) || adhesionIsSubAdminOf(resource.data.get('province', ''));
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['uid', 'email', 'province', 'application', 'signature', 'status', 'adminNote', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'email', 'province', 'application', 'signature', 'status', 'adminNote', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.adminNote == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.province in adhesionProvinces()
        && okText(request.resource.data.email, 254)
        && request.resource.data.signature is string
        && request.resource.data.signature.size() > 0
        && request.resource.data.signature.size() <= 20000
        && adhesionAppOk(request.resource.data.application, request.resource.data.province);
      allow update: if (
          (isAdmin() || adhesionIsSubAdminOf(resource.data.get('province', '')))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adminNote', 'adminSignature', 'signedBy', 'signedAt', 'updatedAt'])
          && request.resource.data.status in ['pending', 'needs_completion', 'accepted', 'refused']
          && okText(request.resource.data.adminNote, 1000)
          && request.resource.data.updatedAt == request.time
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt'])
            || (
              request.resource.data.status == 'accepted'
              && request.resource.data.adminSignature is string
              && request.resource.data.adminSignature.size() > 0
              && request.resource.data.adminSignature.size() <= 20000
              && request.resource.data.signedBy == request.auth.uid
              && request.resource.data.signedAt == request.time
            )
          )
        )
        || (
          signedIn() && request.auth.uid == uid
          && resource.data.uid == uid
          && resource.data.status in ['needs_completion', 'accepted']
          && request.resource.data.keys().hasAll(adhesionTopKeys())
          && request.resource.data.keys().hasOnly(adhesionTopKeys())
          && (resource.data.status == 'needs_completion' || request.resource.data.application.type == 'renewal')
          && request.resource.data.uid == uid
          && request.resource.data.province in adhesionProvinces()
          && request.resource.data.province == resource.data.province
          && request.resource.data.email == resource.data.email
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.status == 'pending'
          && request.resource.data.adminNote == ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['application', 'signature', 'status', 'adminNote', 'adminSignature', 'signedBy', 'signedAt', 'updatedAt'])
          && request.resource.data.get('adminSignature', '') == ''
          && request.resource.data.get('signedBy', '') == ''
          && request.resource.data.get('signedAt', '') == ''
          && okText(request.resource.data.email, 254)
          && request.resource.data.signature is string
          && request.resource.data.signature.size() > 0
          && request.resource.data.signature.size() <= 20000
          && adhesionAppOk(request.resource.data.application, request.resource.data.province)
        );
      allow delete: if isAdmin();
    }

    match /adhesionDocuments/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid) || adhesionIsSubAdminOf(resource.data.get('province', ''));
      allow create, update: if (isAdmin() || adhesionIsSubAdminOf(request.resource.data.get('province', '')))
        && request.resource.data.keys().hasOnly(['uid', 'province', 'fileName', 'mimeType', 'data', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.province in adhesionProvinces()
        && okText(request.resource.data.fileName, 120)
        && request.resource.data.mimeType == 'application/pdf'
        && request.resource.data.data is string
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 200000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/adhesionRequests/$(uid))
        && get(/databases/$(database)/documents/adhesionRequests/$(uid)).data.uid == uid
        && get(/databases/$(database)/documents/adhesionRequests/$(uid)).data.province == request.resource.data.province
        && get(/databases/$(database)/documents/adhesionRequests/$(uid)).data.status == 'accepted'
        && get(/databases/$(database)/documents/adhesionRequests/$(uid)).data.get('signedBy', '') is string
        && get(/databases/$(database)/documents/adhesionRequests/$(uid)).data.get('signedBy', '').size() > 0
        && get(/databases/$(database)/documents/adhesionRequests/$(uid)).data.get('adminSignature', '').size() > 0;
      allow delete: if isAdmin();
    }

    match /notifications/{uid}/items/{id} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && (isAdmin() || (isSubAdmin() && get(/databases/$(database)/documents/members/$(uid)).data.prov == assignedProvince()))
        && request.resource.data.read == false
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() <= 500
        && request.resource.data.type in ['info','adhesion','event','news','report']
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['title','body','createdAt','read','type','targetScreen','targetId','authorUid','province','targetType']);
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;
      allow delete: if isAdmin();
    }

    match /fcmTokens/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.token is string && request.resource.data.token.size() > 0 && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

  }
}
